<?xml version="1.0"?>
<robot name="door_pull">
  <link name="frame">
    <inertial><origin xyz="0 0 1"/><mass value="20"/><inertia ixx="7" iyy="7" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="-0.06 0 1"/><geometry><box size="0.1 0.12 2.1"/></geometry><material name="frame_color"><color rgba="0.25 0.25 0.25 1"/></material></visual>
    <collision><origin xyz="-0.06 0 1"/><geometry><box size="0.1 0.12 2.1"/></geometry></collision>
  </link>
  <link name="panel">
    <inertial><origin xyz="0.45 0 1"/><mass value="8"/><inertia ixx="2.67" iyy="3.21" izz="0.54" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0.45 0 1"/><geometry><box size="0.9 0.06 2"/></geometry><material name="door_color"><color rgba="0.5 0.3 0.15 1"/></material></visual>
    <collision><origin xyz="0.45 0 1"/><geometry><box size="0.9 0.06 2"/></geometry></collision>
  </link>
  <joint name="hinge" type="revolute">
    <parent link="frame"/><child link="panel"/><origin xyz="0 0 0"/><axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.7" effort="100" velocity="5"/><dynamics damping="0.5" friction="0.05"/>
  </joint>
  <link name="handle">
    <inertial><mass value="0.15"/><inertia ixx="0.0003" iyy="0.0003" izz="0.0003" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.14 0.08 0.04"/></geometry><material name="handle_color"><color rgba="0.8 0.8 0.8 1"/></material></visual>
    <collision><geometry><box size="0.14 0.08 0.04"/></geometry></collision>
  </link>
  <joint name="handle_mount" type="fixed"><parent link="panel"/><child link="handle"/><origin xyz="0.78 -0.25 1"/></joint>
</robot>
