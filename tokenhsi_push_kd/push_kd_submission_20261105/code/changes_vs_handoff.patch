+def lagrange_kd_loss(per_sample_kl, task, coef):
+    """Per-task weighted KD: sum_k coef_k * (n_k / n) * mean KL_k over tasks k = 0..len(coef)-1.
+    With equal coefficients this equals coef * mean KL, i.e. the fixed-coefficient loss.
+    Returns (loss, per-task mean KL with NaN for absent tasks)."""
+    n = len(coef)
+    count = torch.bincount(task, minlength=n).to(per_sample_kl.dtype)
+    total = torch.zeros(n, dtype=per_sample_kl.dtype, device=per_sample_kl.device).index_add(0, task, per_sample_kl)
+    loss = (coef.to(per_sample_kl.dtype) * total).sum() / count.sum().clamp_min(1)
+    mean = torch.where(count > 0, total / count.clamp_min(1), torch.full_like(total, float('nan')))
+    return loss, mean
+
+
+def feature_distill_loss(student_feature, teacher_feature):
+    """Mean squared distance between student and frozen-teacher features (mean over dims and samples)."""
+    if student_feature.shape[0] == 0:
+        return student_feature.sum() * 0
+    return (student_feature.float() - teacher_feature.detach().float()).square().mean()
+
+
+def adapt_coefficient(coef, kl, target, factor, tolerance, low, high):
+    """Adaptive KL penalty (Schulman et al. 2017, PPO): double the coefficient when KL exceeds
+    tolerance x target, halve it when below target / tolerance. NaN KL (task absent) keeps coef."""
+    seen = ~torch.isnan(kl)
+    up = seen & (kl > tolerance * target)
+    down = seen & (kl < target / tolerance)
+    coef = torch.where(up, coef * factor, torch.where(down, coef / factor, coef))
+    return coef.clamp(low, high)
 
 
